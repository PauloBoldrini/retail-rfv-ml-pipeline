PROJECT_ID=your-project-id
BQ_LOCATION=your-region
RFV_DATASET=your-target-dataset
RFV_BUCKET=your-audit-bucket

CUSTOMER_MASTER_TABLE=your-project.your_dataset.customer_master
SALES_TABLE=your-project.your_dataset.sales_history

RFV_BASE_TABLE=your-project.your_dataset.rfv_base_final
RFV_TRANSITIONS_TABLE=your-project.your_dataset.rfv_transition_log
RFV_RUNS_TABLE=your-project.your_dataset.rfv_execution_log

RFV_MODEL_PREFIX=models/RFV_2.0
RFV_MODEL_VERSION=RFV_2.0
HIGH_VALUE_CHURN_THRESHOLD=SET_ME
CHURN_DAYS=180
NEW_CUSTOMER_DAYS=30
MIN_PURCHASE_DAYS_FOR_MODEL=3

RFV_FUNCTION_NAME=rfv-pipeline
RFV_FUNCTION_URL=https://REGION-PROJECT.cloudfunctions.net/rfv-pipeline
RFV_SERVICE_ACCOUNT=service-account@project.iam.gserviceaccount.com
RFV_SCHEDULER_JOB=scheduler-rfv-pipeline
RFV_SCHEDULE=30 10 * * *
RFV_TIME_ZONE=America/Sao_Paulo
